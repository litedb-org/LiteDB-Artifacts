-                if (!_reading) Close();
-            }
-            GC.SuppressFinalize(this);
-        }
-
-        private void Close()
-        {
-            var entry = _entry;
-            var reader = _reader;
-            var context = _context;
-            _entry = null;
-            _reader = null;
-            _context = null;
