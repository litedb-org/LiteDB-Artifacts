-                    cleanup.Catch(() =>
-                    {
-                        _engine.Close(final: true);
-                        _engine = null;
-                        closed = true;
-                    });
+                    // A thrown admission/refusal error means this core has not closed:
+                    // do not continue into dependent native-ownership release below.
+                    _engine.Close(final: true);
