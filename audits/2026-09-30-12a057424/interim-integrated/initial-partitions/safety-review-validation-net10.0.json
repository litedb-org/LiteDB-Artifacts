[
  {
    "name": "safety-review-handles-net10.0",
    "command": [
      "dotnet",
      "test",
      "LiteDB.Tests",
      "-c",
      "Release",
      "-f",
      "net10.0",
      "-p:TestingEnabled=true",
      "--settings",
      "tests.runsettings",
      "--filter",
      "FullyQualifiedName~TransactionHandle|FullyQualifiedName~TransactionCompletion|FullyQualifiedName~PageBufferAbandonment|FullyQualifiedName~SortDiskCleanup",
      "--logger",
      "trx;LogFileName=safety-review-handles-net10.0.trx"
    ],
    "exit": 0
  },
