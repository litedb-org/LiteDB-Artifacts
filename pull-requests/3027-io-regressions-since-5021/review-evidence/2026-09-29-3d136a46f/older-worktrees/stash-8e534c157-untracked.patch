+        /// <summary>
+        /// The v13 promotion inside a retiring checkpoint's PrepareRetirement is the first to find
+        /// that the data file cannot sync. Does the checkpoint then still write to the data file?
+        /// </summary>
+        [Fact]
+        public void Probe_checkpoint_continues_after_promotion_data_sync_failed()
+        {
+            using var file = new TempFile();
+            Setup(file.Filename);
+            Header(file.Filename)[HeaderPage.P_FILE_VERSION].Should().BeLessThan(HeaderPage.MVCC_FILE_VERSION);
+            var logName = FileHelper.GetLogFile(file.Filename);
+            using var power = new SyncPowerLossModel(file.Filename);
+            var settings = power.Settings();
+            var pagesAfterFailure = 0;
+            var armed = false;
+            (byte[] Data, byte[] Log) beforePromotion = default;
+            var logSyncsAtFailure = -1;
+            settings.CheckpointStage = stage => { if (stage == "data-page" && power.DataFails) pagesAfterFailure++; };
+            using var engine = new LiteEngine(settings);
+            engine.SimulateCrashPoint = phase =>
+            {
+                if (!armed) return;
+                if (phase == "promotion-before-journal-write") beforePromotion = power.Capture();
+                if (phase == "promotion-after-header-write") { power.DataFails = true; logSyncsAtFailure = power.LogSyncs; }
+            };
+            using var db = new LiteDatabase(engine, disposeOnClose: false);
+            db.CheckpointSize = 0;
+            for (var value = 1; value <= 5; value++) UpdateWithNewPages(db, value);
+            Exception thrown = null;
+            using (var reader = engine.Query("rows", new Query()))
+            {
+                reader.Read().Should().BeTrue();
+                Worker(() =>
+                {
+                    for (var value = 6; value <= 9; value++) Update(db, value);
+                    DurableLogFlush(db).Should().BeTrue();
+                    armed = true;
+                    try { db.Checkpoint(); } catch (Exception ex) { thrown = ex; }
+                    armed = false;
+                });
+            }
+            _out.WriteLine($"dataFails={power.DataFails} pagesWrittenAfterFailedDataSync={pagesAfterFailure} thrown={thrown?.GetType().Name}: {thrown?.Message}");
+            _out.WriteLine($"log syncs at failure={logSyncsAtFailure} after checkpoint={power.LogSyncs}");
+            power.DataFails.Should().BeTrue("the promotion ran");
+
+            var durable = power.Capture();
+            var osData = SyncPowerLossModel.ReadShared(file.Filename);
+            var osLog = SyncPowerLossModel.ReadShared(logName);
+            var page0Changed = Enumerable.Range(0, Constants.PAGE_SIZE).Where(i => osData[i] != durable.Data[i]).ToArray();
+            _out.WriteLine($"header bytes changed in OS cache vs durable: {page0Changed.Length}, max offset {(page0Changed.Length == 0 ? -1 : page0Changed.Max())}");
+            _out.WriteLine($"durable log={durable.Log.Length} log before promotion={beforePromotion.Log?.Length} OS log={osLog.Length}");
+
+            // The OS wrote back the WAL's truncation (the state before the promotion's journal) and
+            // then the first 4 KiB of the backfilled header page; power fails before the rest.
+            var torn = (byte[])durable.Data.Clone();
+            Buffer.BlockCopy(osData, 0, torn, 0, 4096);
+            foreach (var (name, image) in new[]
+            {
+                ("durable pair", durable),
+                ("OS pair", (osData, osLog)),
+                ("torn header + durable log", (torn, durable.Log)),
+                ("torn header + log as before promotion", (torn, beforePromotion.Log)),
+            })
+            {
+                try { _out.WriteLine($"{name}: values {string.Join(",", FilePowerLossModel.Open(image, Values))}"); }
+                catch (Exception ex) { _out.WriteLine($"{name}: OPEN FAILED {ex.GetType().Name}: {ex.Message}"); }
+            }
+            pagesAfterFailure.Should().Be(0, "a checkpoint writes nothing to a data file whose sync just failed");
+        }
