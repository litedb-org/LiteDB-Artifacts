+        /// <summary>
+        /// Same as above with a header whose collection list crosses the 4 KiB boundary, so the
+        /// backfilled header page can be written back torn at OS-page granularity. The OS wrote
+        /// back the log as the promotion left it (its journal truncated), then the first 4 KiB of
+        /// the backfilled header; the checkpoint's own journal never synced.
+        /// </summary>
+        [Fact]
+        public void Probe_torn_backfilled_header_after_promotion_failure_has_no_durable_repair_copy()
+        {
+            using var file = new TempFile();
+            using (var setup = new LiteDatabase(file.Filename))
+            {
+                setup.GetCollection("rows").Insert(Enumerable.Range(1, Rows).Select(id => MvccRetirementScenario.Document(id, 0)));
+                for (var i = 0; i < 160; i++) setup.GetCollection($"collection_with_long_name_{i:D4}").Insert(new BsonDocument { ["_id"] = 1 });
+            }
+            var logName = FileHelper.GetLogFile(file.Filename);
+            using var power = new SyncPowerLossModel(file.Filename);
+            var settings = power.Settings();
+            var pagesAfterFailure = 0;
+            var armed = false;
+            (byte[] Data, byte[] Log) beforePromotion = default;
+            settings.CheckpointStage = stage => { if (stage == "data-page" && power.DataFails) pagesAfterFailure++; };
+            using var engine = new LiteEngine(settings);
+            engine.SimulateCrashPoint = phase =>
+            {
+                if (!armed) return;
+                if (phase == "promotion-before-journal-write") beforePromotion = power.Capture();
+                if (phase == "promotion-after-header-write") power.DataFails = true;
+            };
+            using var db = new LiteDatabase(engine, disposeOnClose: false);
+            db.CheckpointSize = 0;
+            for (var value = 1; value <= 5; value++)
+            {
+                Update(db, value);
+                db.GetCollection($"zz_new_collection_long_name_{value}").Insert(new BsonDocument { ["_id"] = value });
+            }
+            Exception thrown = null;
+            using (var reader = engine.Query("rows", new Query()))
+            {
+                reader.Read().Should().BeTrue();
+                Worker(() =>
+                {
+                    for (var value = 6; value <= 9; value++) Update(db, value);
+                    DurableLogFlush(db).Should().BeTrue();
+                    armed = true;
+                    try { db.Checkpoint(); } catch (Exception ex) { thrown = ex; }
+                    armed = false;
+                });
+            }
+            var durable = power.Capture();
+            var osData = SyncPowerLossModel.ReadShared(file.Filename);
+            var osLog = SyncPowerLossModel.ReadShared(logName);
+            var changed = Enumerable.Range(0, Constants.PAGE_SIZE).Where(i => osData[i] != durable.Data[i]).ToArray();
+            _out.WriteLine($"thrown={thrown?.GetType().Name}; pages after failed sync={pagesAfterFailure}; header bytes changed={changed.Length} min={changed.DefaultIfEmpty(-1).Min()} max={changed.DefaultIfEmpty(-1).Max()}");
+            _out.WriteLine($"durable log={durable.Log.Length} before promotion={beforePromotion.Log?.Length} OS log={osLog.Length}");
+            changed.Max().Should().BeGreaterThan(4096, "the header change spans both OS pages of the header");
+
+            var torn = (byte[])durable.Data.Clone();
+            Buffer.BlockCopy(osData, 0, torn, 0, 4096);
+            var results = new Dictionary<string, string>();
+            foreach (var (name, image) in new[]
+            {
+                ("durable pair", durable),
+                ("OS pair", (osData, osLog)),
+                ("torn header + durable log", (torn, durable.Log)),
+                ("torn header + OS log", (torn, osLog)),
+                ("torn header + log as the promotion left it", (torn, beforePromotion.Log)),
+            })
+            {
+                string result;
+                try { result = "values " + string.Join(",", FilePowerLossModel.Open(image, Values)); }
+                catch (Exception ex) { result = $"OPEN FAILED {ex.GetType().Name}: {ex.Message}"; }
+                results[name] = result;
+                _out.WriteLine($"{name}: {result}");
+            }
+            results["torn header + log as the promotion left it"].Should().Be("values 9");
+        }
