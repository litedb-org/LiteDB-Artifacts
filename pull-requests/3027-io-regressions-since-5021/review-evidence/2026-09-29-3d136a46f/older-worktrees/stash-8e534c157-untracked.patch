+        /// <summary>
+        /// Owner's case: a reclaiming checkpoint whose data sync fails from a stage on. Every commit
+        /// acknowledged durable must survive each power-loss image, and restarts must keep them.
+        /// </summary>
+        [Theory]
+        [InlineData("data-page")]
+        [InlineData("data-flushed")]
+        [InlineData("before-reclaim")]
+        [InlineData("after-reclaim")]
+        public void Probe_reclaiming_checkpoint_data_sync_fails_at(string stage)
+        {
+            using var file = new TempFile();
+            Setup(file.Filename);
+            var logName = FileHelper.GetLogFile(file.Filename);
+            using var power = new SyncPowerLossModel(file.Filename);
+            var engine = new LiteEngine(power.Settings());
+            var db = new LiteDatabase(engine, disposeOnClose: false);
+            db.CheckpointSize = 0;
+            for (var value = 1; value <= 5; value++)
+            {
+                Update(db, value);
+                DurableLogFlush(db).Should().BeTrue();
+            }
+            var logBefore = new FileInfo(logName).Length;
+            power.RetirementStage = stage;
+            Exception thrown = null;
+            try { db.Checkpoint(); } catch (Exception ex) { thrown = ex; }
+            power.RetirementStage = null;
+            _out.WriteLine($"stage={stage} thrown={thrown?.GetType().Name}: {thrown?.Message}");
+            _out.WriteLine($"log before={logBefore} after={new FileInfo(logName).Length} dataFails={power.DataFails}");
+            power.DataFails.Should().BeTrue();
+            if (stage != "after-reclaim")
+            {
+                thrown.Should().BeOfType<IOException>();
+                new FileInfo(logName).Length.Should().BeGreaterThan(0, "the WAL is kept");
+                Action write = () => Update(db, 6);
+                write.Should().Throw<Exception>("the engine stopped");
+            }
+
+            // power-loss images
+            var durable = power.Capture();
+            var os = (SyncPowerLossModel.ReadShared(file.Filename), SyncPowerLossModel.ReadShared(logName));
+            FilePowerLossModel.Open(durable, Values).Should().Equal(new[] { 5 }, "each file as of its last sync");
+            FilePowerLossModel.Open(os, Values).Should().Equal(new[] { 5 }, "OS state of both files");
+            FilePowerLossModel.Open((os.Item1, durable.Log), Values).Should().Equal(new[] { 5 }, "OS data, durable log");
+            FilePowerLossModel.Open((durable.Data, os.Item2), Values).Should().Equal(new[] { 5 }, "durable data, OS log");
+
+            try { db.Dispose(); } catch (Exception ex) { _out.WriteLine("db dispose: " + ex.Message); }
+            try { engine.Dispose(); } catch (Exception ex) { _out.WriteLine("engine dispose: " + ex.Message); }
+            _out.WriteLine($"log after dispose={new FileInfo(logName).Length}");
+
+            // restart while the data file still cannot sync
+            DurableHeaders.Forget(file.Filename);
+            var beforeReopen = (SyncPowerLossModel.ReadShared(file.Filename), SyncPowerLossModel.ReadShared(logName));
+            Exception reopen = null;
+            try
+            {
+                using var again = new LiteDatabase(new LiteEngine(power.Settings()));
+                _out.WriteLine("reopen writable values: " + string.Join(",", Values(again)));
+                again.Checkpoint();
+            }
+            catch (Exception ex) { reopen = ex; }
+            _out.WriteLine($"reopen while unsyncable: {reopen?.GetType().Name}: {reopen?.Message}");
+            var afterReopen = (SyncPowerLossModel.ReadShared(file.Filename), SyncPowerLossModel.ReadShared(logName));
+            _out.WriteLine($"refused open left data identical={beforeReopen.Item1.SequenceEqual(afterReopen.Item1)} log identical={beforeReopen.Item2.SequenceEqual(afterReopen.Item2)}");
+            FilePowerLossModel.Open(power.Capture(), Values).Should().Equal(new[] { 5 });
+            var readOnly = power.Settings();
+            readOnly.ReadOnly = true;
+            try
+            {
+                using var ro = new LiteDatabase(new LiteEngine(readOnly));
+                _out.WriteLine("readonly values: " + string.Join(",", Values(ro)));
+            }
+            catch (Exception ex) { _out.WriteLine($"readonly open FAILED {ex.GetType().Name}: {ex.Message}"); }
+
+            // storage syncs again, new process
+            power.DataFails = false;
+            DurableHeaders.Forget(file.Filename);
+            using (var healed = new LiteDatabase(new LiteEngine(power.Settings())))
+            {
+                Values(healed).Should().Equal(5);
+                healed.Checkpoint();
+                new FileInfo(logName).Length.Should().Be(0);
+            }
+            FilePowerLossModel.Open(power.Capture(), Values).Should().Equal(new[] { 5 });
+        }
