+                    raw.ReadRequired(buffer, 0, count);
+                    sha.TransformBlock(buffer, 0, count, null, 0);
+                    remaining -= count;
+                }
+                sha.TransformFinalBlock(buffer, 0, 0);
+                return sha.Hash;
+            }
+        }
