+                        stream.ReadRequired(page, 0, PAGE_SIZE);
+                        sha.TransformBlock(page, 0, PAGE_SIZE, null, 0);
+                    }
+                    sha.TransformFinalBlock(page, 0, 0);
+                    return (length, sha.Hash);
+                }
+            }
