                 rows.Insert(new BsonDocument { ["_id"] = 3, ["value"] = "recovered" });
             }
             using (var reopened = new LiteDatabase(new LiteEngine(settings)))
@@ -73,10 +96,8 @@ namespace LiteDB.Tests.Issues
