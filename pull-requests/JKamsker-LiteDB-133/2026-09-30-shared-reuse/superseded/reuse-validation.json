      "-p:TestingEnabled=true",
      "--settings",
      "tests.runsettings",
      "--filter",
      "FullyQualifiedName~LiteDB.Tests.Engine.Shared|FullyQualifiedName~CrossProcess_Shared",
      "--logger",
      "trx;LogFileName=reuse-shared-engine-net8.0.trx"
    ],
    "exit": 0
  },
  {
    "name": "reuse-shared-native-net8.0",
