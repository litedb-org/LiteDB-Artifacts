      "-c",
      "Release",
      "-f",
      "net8.0",
      "-p:TestingEnabled=true",
      "--settings",
      "tests.runsettings",
      "--filter",
      "(FullyQualifiedName~Shared&FullyQualifiedName!~LiteDB.Tests.Engine.Shared&FullyQualifiedName!~CrossProcess_Shared&FullyQualifiedName!~TransactionHandle)|FullyQualifiedName~NativeAdmission",
      "--logger",
      "trx;LogFileName=reuse-shared-native-net8.0.trx"
    ],
    "exit": 0
  },
